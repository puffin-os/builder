#!/bin/sh
set -eu

payload=/usr/lib/puffin/puffin-server-x86-64.raw.zst
target_mount=/run/puffin-target-var
key_file=/run/puffin-installer.key
mapper=puffin-installer-var
disk_choices=/run/puffin-installer-disks
interface_choices=/run/puffin-installer-interfaces

cleanup() {
    mountpoint -q "$target_mount" && umount "$target_mount" || true
    cryptsetup status "$mapper" >/dev/null 2>&1 && cryptsetup close "$mapper" || true
    rm -f -- "$key_file" "$disk_choices" "$interface_choices"
}
trap cleanup EXIT INT TERM

ask() {
    answer=$(gum input --header "$1") || exit $?
}

ask_secret() {
    answer=$(gum input --password --header "$1") || exit $?
}

valid_hostname() {
    case "$1" in
        '' | *[!a-zA-Z0-9.-]* | .* | *..* | *.) return 1 ;;
    esac
}

valid_user() {
    case "$1" in
        '' | *[!a-z_0-9-]* | [0-9-]* | root) return 1 ;;
    esac
}

if test "${1:-}" = --self-test; then
    valid_hostname server-1
    ! valid_hostname ''
    valid_user admin
    ! valid_user root
    echo 'Installer input checks passed'
    exit
fi

source_partition=$(findmnt -n -o SOURCE /var)
source_parent=$(lsblk -ndo PKNAME "$source_partition")
source_disk=/dev/$source_parent

clear
gum style --bold --foreground 212 'Puffin server installer'
gum style --foreground 214 \
    'This installer erases one complete disk. There is no partition editor.'
printf '\n'
printf 'Available target disks:\n'
: >"$disk_choices"
for candidate in $(lsblk -dnpo NAME,TYPE,RO | awk '$2 == "disk" && $3 == "0" { print $1 }'); do
    test "$candidate" = "$source_disk" && continue
    lsblk -dno NAME,SIZE,MODEL "$candidate"
    printf '%s\n' "$candidate" >>"$disk_choices"
done
printf '\n'

test -s "$disk_choices" || { echo 'No target disks are available.' >&2; exit 1; }
disk=$(gum choose --header 'Target disk' <"$disk_choices") || exit $?
test -b "$disk" || { echo "Not a block device: $disk" >&2; exit 1; }
test "$(lsblk -dno TYPE "$disk")" = disk || { echo "Select a whole disk" >&2; exit 1; }
test "$disk" != "$source_disk" || { echo "The installer medium cannot be selected" >&2; exit 1; }
test "$(blockdev --getsize64 "$disk")" -ge 33822867456 ||
    { echo "Target disk must be at least 32 GiB" >&2; exit 1; }
if lsblk -nrpo MOUNTPOINT "$disk" | grep -q '^/'; then
    echo "A target partition is mounted; unmount it first" >&2
    exit 1
fi

while :; do
    ask 'Hostname: '
    hostname=$answer
    valid_hostname "$hostname" && break
    echo 'Use letters, digits, dots, and hyphens.'
done

keymap=$(localectl --no-pager list-keymaps |
    gum filter --fuzzy --placeholder 'Console keyboard layout') || exit $?
loadkeys "$keymap"
timezone=$(timedatectl --no-pager list-timezones |
    gum filter --fuzzy --placeholder 'Timezone') || exit $?

while :; do
    ask 'Administrator username: '
    username=$answer
    valid_user "$username" && break
    echo 'Use a lowercase name beginning with a letter or underscore.'
done

while :; do
    ask_secret 'Administrator password: '
    password=$answer
    test -n "$password" || { echo 'Password cannot be empty.'; continue; }
    ask_secret 'Confirm administrator password: '
    test "$password" = "$answer" && break
    echo 'Passwords do not match.'
done

ask 'SSH public key (optional): '
ssh_key=$answer
case "$ssh_key" in
    '' | ssh-ed25519\ * | ssh-rsa\ * | ecdsa-sha2-*\ *) ;;
    *) echo 'Unsupported SSH public key format.' >&2; exit 1 ;;
esac

: >"$interface_choices"
for path in /sys/class/net/*; do
    interface=${path##*/}
    test "$interface" = lo || printf '%s\n' "$interface" >>"$interface_choices"
done
test -s "$interface_choices" ||
    { echo 'No network interfaces are available.' >&2; exit 1; }
interface=$(gum choose --header 'Network interface' <"$interface_choices") || exit $?
test -e "/sys/class/net/$interface" && test "$interface" != lo ||
    { echo "Unknown network interface" >&2; exit 1; }

network_mode=$(gum choose --header 'Network mode' dhcp static) || exit $?
case "$network_mode" in
    dhcp) ;;
    static)
        ask 'IPv4 address with prefix (for example 192.0.2.10/24): '
        address=$answer
        ipcalc -c "$address" >/dev/null
        ask 'IPv4 gateway: '
        gateway=$answer
        ipcalc -c "$gateway" >/dev/null
        ask 'DNS servers separated by spaces: '
        dns=$answer
        test -n "$dns" || { echo 'At least one DNS server is required.' >&2; exit 1; }
        for server in $dns; do ipcalc -c "$server" >/dev/null; done
        ;;
    *) echo 'Network mode must be dhcp or static.' >&2; exit 1 ;;
esac

if gum confirm 'Encrypt /var with LUKS2?'; then
    encrypt=yes
else
    encrypt=no
fi
if test "$encrypt" = yes; then
    while :; do
        ask_secret 'LUKS passphrase: '
        luks_password=$answer
        test -n "$luks_password" || { echo 'Passphrase cannot be empty.'; continue; }
        ask_secret 'Confirm LUKS passphrase: '
        test "$luks_password" = "$answer" && break
        echo 'Passphrases do not match.'
    done
fi

lsblk -dno NAME,SIZE,MODEL "$disk"
gum confirm --default=false "Erase all data on $disk and install Puffin?" ||
    { echo 'Installation cancelled.'; exit 1; }
test -f "$payload" || { echo "Missing server payload" >&2; exit 1; }

echo 'Writing Puffin server image...'
zstd -dc "$payload" | dd of="$disk" bs=16M iflag=fullblock conv=fsync status=progress
blockdev --rereadpt "$disk"
udevadm settle
systemd-repart --dry-run=no --empty=allow "$disk"
udevadm settle

var_partition=$(lsblk -nrpo NAME,PARTLABEL "$disk" |
    awk '$2 == "puffin_var" { print $1; exit }')
test -b "$var_partition" || { echo 'Installed /var partition not found.' >&2; exit 1; }
wipefs -a "$var_partition"

if test "$encrypt" = yes; then
    umask 077
    printf '%s' "$luks_password" >"$key_file"
    cryptsetup luksFormat --batch-mode --type=luks2 \
        --label=puffin_var_luks --key-file="$key_file" "$var_partition"
    cryptsetup open --key-file="$key_file" "$var_partition" "$mapper"
    filesystem=/dev/mapper/$mapper
    if test -e /dev/tpmrm0; then
        if systemd-cryptenroll "$var_partition" \
            --unlock-key-file="$key_file" \
            --tpm2-device=auto \
            --tpm2-pcrs=7; then
            echo 'TPM2 unlock enrolled; the passphrase remains available for recovery.'
        else
            echo 'Warning: TPM2 enrollment failed; continuing with passphrase unlock.' >&2
        fi
    else
        echo 'Warning: no TPM2 device found; continuing with passphrase unlock.' >&2
    fi
else
    filesystem=$var_partition
fi

mkfs.ext4 -F -L puffin_var "$filesystem"
install -d -m 0755 "$target_mount"
mount "$filesystem" "$target_mount"
install -d -m 0755 \
    "$target_mount/home" \
    "$target_mount/roothome" \
    "$target_mount/lib/puffin/esp" \
    "$target_mount/log/journal"

provision=$target_mount/lib/puffin/provision
install -d -m 0700 "$provision"
printf '%s\n' "$username" >"$provision/username"
printf '%s\n' "$hostname" >"$provision/hostname"
printf '%s\n' "$timezone" >"$provision/timezone"
printf '%s\n' "$keymap" >"$provision/keymap"
password_hash=$(printf '%s\n' "$password" | openssl passwd -6 -stdin)
printf '%s\n' "$password_hash" >"$provision/password-hash"
if test -n "$ssh_key"; then
    printf '%s\n' "$ssh_key" >"$provision/ssh-authorized-key"
fi

network_file=$provision/network
if test "$network_mode" = dhcp; then
    cat >"$network_file" <<EOF
[Match]
Name=$interface

[Network]
DHCP=yes
IPv6AcceptRA=yes
EOF
else
    {
        printf '[Match]\nName=%s\n\n[Network]\nAddress=%s\nGateway=%s\n' \
            "$interface" "$address" "$gateway"
        for server in $dns; do printf 'DNS=%s\n' "$server"; done
    } >"$network_file"
fi
chmod 0600 "$network_file"
chmod 0600 "$provision"/*

sync
umount "$target_mount"
test "$encrypt" = no || cryptsetup close "$mapper"
rm -f -- "$key_file" "$disk_choices" "$interface_choices"
trap - EXIT INT TERM

printf '\n'
gum style --bold --foreground 42 'Installation complete.'
gum style 'Remove the installer medium before rebooting.'
gum confirm 'Reboot now?' && systemctl reboot
