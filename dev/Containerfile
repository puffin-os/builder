FROM registry.fedoraproject.org/fedora@sha256:f8f22a4890139a9800df26a9b7807767e6a33eb6762be6b11e5e49f14d3425b7

# Install builder tools with exact versions pinned in the lockfile.
# The base image digest pins the Fedora release; this lockfile pins every
# package dnf installs so the builder is reproducible.  Update both the
# digest and lockfile together when advancing the builder.
COPY dev/builder-packages.lock /tmp/builder-packages.lock

RUN dnf install -y \
        $(awk '/^[a-z]/ {printf "%s ", $0}' /tmp/builder-packages.lock) \
    && dnf clean all

WORKDIR /work/base
